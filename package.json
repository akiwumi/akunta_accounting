{
  "name": "accounting-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "npm run prisma:generate",
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "dev:clean": "rm -rf .next-dev && NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push || npm run db:init",
    "db:init": "[ -f prisma/dev.db ] || (prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/init.sql && sqlite3 prisma/dev.db < prisma/init.sql)",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-receipt-transactions": "tsx scripts/backfill-receipt-transactions.ts",
    "db:reextract-receipts": "tsx scripts/reextract-receipts.ts",
    "db:migrate-swedish-tax": "tsx scripts/migrate-swedish-tax.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@sentry/nextjs": "^10.48.0",
    "@supabase/supabase-js": "^2.101.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "papaparse": "^5.4.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.10.0",
    "stripe": "^22.0.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.22",
    "glob@>=9 <14.0.2": "^14.0.6",
    "minimatch@>=7 <11.0.1": "^11.0.8",
    "esbuild": "^0.28.2"
  }
}
