# ── Database ──────────────────────────────────────────────────────────────
# Supabase (production): DATABASE_URL is the transaction pooler (port 6543) and
# must carry ?pgbouncer=true&connection_limit=1 so serverless functions do not
# exhaust connections. DIRECT_URL is the session connection (port 5432) and is
# used only by migrations and backups.
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"
# Local development: point both at the same local Postgres database.
# Apply the schema with: npm run db:migrate
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

NEXT_PUBLIC_APP_URL="https://akuntaaccounts.com"
AUTH_EMAIL_PROVIDER="smtp"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── STRATO SMTP ───────────────────────────────────────────────────────────
SMTP_HOST="smtp.strato.de"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@akuntaaccounts.com"
SMTP_PASS=""
EMAIL_FROM="Akunta <noreply@akuntaaccounts.com>"
RESEND_API_KEY=""
SUPPORT_EMAIL=""

# ── AI / OCR ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_RECEIPT_MODEL="gpt-4.1-mini"

# ── Security ──────────────────────────────────────────────────────────────
EMAIL_WEBHOOK_SECRET=""

# ── File storage ──────────────────────────────────────────────────────────
# Without the service role key, files are written to local disk (dev only).
# Both buckets must be PRIVATE. Server-side only: never expose this key.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="receipts"
SUPABASE_INVOICE_BUCKET="invoices"

# ── Receipts by email ─────────────────────────────────────────────────────
# Domain your inbound mail provider delivers to /api/receipts/email-webhook.
# Each business gets receipts+<token>@<domain>. Leave empty to hide the feature.
RECEIPT_INBOX_DOMAIN=""

# ── Scheduled jobs ────────────────────────────────────────────────────────
# Bearer token for /api/cron/* (invoice reminders, recurring invoices). Vercel
# Cron sends it automatically when this variable is set. Without it the jobs
# answer 503 and nothing is sent.
CRON_SECRET=""

# ── Sessions ──────────────────────────────────────────────────────────────
# Required in production. Long random string; changing it signs everyone out.
SESSION_SALT=""
